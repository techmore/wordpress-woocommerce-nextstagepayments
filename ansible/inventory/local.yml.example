---
# Local Apple `container` machine (macOS container machine, runs real Ubuntu).
# This file is generated by scripts/container-setup.sh; the example is only a
# reference. See group_vars/local.yml for how IP-based site URL is derived.
all:
  children:
    local:
      hosts:
        wp-dev:
          ansible_host: 192.168.5.2
          ansible_port: 22
          ansible_user: YOUR_MAC_USERNAME
          ansible_become: true
          ansible_become_method: sudo