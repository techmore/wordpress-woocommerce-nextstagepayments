# Ubuntu 24.04 container machine image (systemd + OpenSSH + tooling).
# Builds with: container build -t local/ubuntu-machine:latest .
# Based on the official Apple docs: https://github.com/apple/container

FROM ubuntu:24.04

ENV container container

RUN apt-get update && \
    apt-get install -y \
        dbus systemd openssh-server \
        net-tools iproute2 iputils-ping \
        curl wget vim-tiny man sudo python3 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Wipe machine-id so each container machine gets a fresh one
RUN >/etc/machine-id
RUN >/var/lib/dbus/machine-id

# Ensure /sbin/init points at systemd (container machine requirement)
RUN ln -sf /lib/systemd/systemd /sbin/init

RUN systemctl set-default multi-user.target
RUN systemctl mask \
      dev-hugepages.mount \
      sys-fs-fuse-connections.mount \
      systemd-update-utmp.service \
      systemd-tmpfiles-setup.service \
      console-getty.service
RUN systemctl disable \
      networkd-dispatcher.service

# Start sshd on boot so Ansible (and you) can connect over SSH
RUN systemctl enable ssh

RUN sed -i -e 's/^AcceptEnv LANG LC_\*$/#AcceptEnv LANG LC_*/' /etc/ssh/sshd_config